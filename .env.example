# Server Configuration
PORT=8081
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK Configuration
# Option 1: Use file path (recommended for local development)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json

# Option 2: Use JSON string (recommended for production/deployment)
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Note: Only set ONE of the above options (GOOGLE_APPLICATION_CREDENTIALS or GOOGLE_SERVICE_ACCOUNT)
